{
  "manifest_version": 3,
  "name": "Full Page Screenshot",
  "version": "1.1.2",
  "description": "One-click full-page screenshot capture, markup annotations, blur redaction, and PDF/PNG export.",
  "author": "NSP-MO",
  "homepage_url": "https://github.com/NSP-MO/Full-Page-Screenshoot",
  "browser_specific_settings": {
    "gecko": {
      "id": "full-page-screenshot@nsp-mo.github.io",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "unlimitedStorage",
    "clipboardWrite"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Take Full Page Screenshot"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": [
      "background/service-worker.js"
    ]
  }
}
